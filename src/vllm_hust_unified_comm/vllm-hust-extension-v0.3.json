{
  "schema_version": "0.3-experimental",
  "extension_id": "org.vllm-hust.unified-communication",
  "extension_version": "0.2.0.dev0",
  "kind": "in_process_plugin",
  "host": {
    "provider": "vllm",
    "name": "vllm",
    "version_range": ">=0",
    "api_range": ">=1,<2"
  },
  "runtime": {
    "type": "python",
    "process_scope": "vllm-processes",
    "isolation": "trusted_in_process"
  },
  "lifecycle_owner": "vllm",
  "protocols": [
    {"name": "vllm.communication.backend", "version_range": ">=1,<2"},
    {"name": "vllm.communication.group", "version_range": ">=1,<2"},
    {"name": "vllm.communication.collectives", "version_range": ">=1,<2"},
    {"name": "vllm.communication.topology", "version_range": ">=1,<2"}
  ],
  "components": [
    {
      "component_id": "communication-backend-registry",
      "implementation_ref": "vllm_hust_unified_comm.contracts:CommBackendRegistry",
      "contracts": ["vllm.communication.backend.v1"],
      "execution_planes": ["worker"],
      "isolation": "trusted_in_process",
      "permissions": []
    },
    {
      "component_id": "communication-strategy",
      "implementation_ref": "vllm_hust_unified_comm.strategy:DefaultStrategy",
      "contracts": ["vllm.communication.topology.v1", "vllm.communication.collectives.v1"],
      "execution_planes": ["worker"],
      "isolation": "trusted_in_process",
      "permissions": []
    },
    {
      "component_id": "communication-provider",
      "implementation_ref": "vllm_hust_unified_comm.provider:UnifiedCommunicationProvider",
      "contracts": [
        "vllm.communication.backend.v1",
        "vllm.communication.collectives.v1"
      ],
      "execution_planes": [
        "worker",
        "device"
      ],
      "isolation": "trusted_in_process",
      "permissions": [
        "device_access"
      ]
    }
  ],
  "implementation": [
    {
      "type": "python_module",
      "module": "vllm_hust_unified_comm.contracts",
      "object": "CommBackendRegistry",
      "status": "import_only"
    },
    {
      "type": "python_module",
      "module": "vllm_hust_unified_comm.strategy",
      "object": "DefaultStrategy",
      "status": "import_only"
    },
    {
      "type": "python_module",
      "module": "vllm_hust_unified_comm.provider",
      "object": "UnifiedCommunicationProvider",
      "status": "active"
    }
  ],
  "requires_services": [],
  "requires_extensions": [],
  "resource_claims": [
    {
      "resource": "vllm.communication.provider",
      "scope": "vllm-process",
      "mode": "exclusive"
    }
  ],
  "activation": {
    "entry_points": [],
    "environment": {
      "VLLM_HUST_COMMUNICATION_PROVIDER": "vllm_hust_unified_comm.provider.UnifiedCommunicationProvider"
    },
    "additional_config": {}
  }
}
