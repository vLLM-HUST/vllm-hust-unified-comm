From 95058caf7cab3b11c83770753d22bfa243567284 Mon Sep 17 00:00:00 2001
From: "Shuhao Zhang (Tony)" <5267690+ShuhaoZhangTony@users.noreply.github.com>
Date: Sat, 25 Jul 2026 19:23:59 +0800
Subject: [PATCH] fix(unified_comm): narrow optional device before cleanup

Make the NCCL communicator cleanup path explicitly narrow the optional device before entering the accelerator context.

Co-authored-by: Codex <codex@openai.com>
Signed-off-by: Shuhao Zhang (Tony) <5267690+ShuhaoZhangTony@users.noreply.github.com>
---
 vllm/distributed/unified_comm/backends/nccl_backend.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/vllm/distributed/unified_comm/backends/nccl_backend.py b/vllm/distributed/unified_comm/backends/nccl_backend.py
index b2d2bbdab..6af1d5f56 100644
--- a/vllm/distributed/unified_comm/backends/nccl_backend.py
+++ b/vllm/distributed/unified_comm/backends/nccl_backend.py
@@ -439,7 +439,9 @@ class NCCLBackend(CommBackend):
         """销毁通信组，释放所有资源"""
         if comm_handle.nccl_comm is not None and comm_handle.nccl_lib is not None:
             try:
-                with torch.accelerator.device_index(comm_handle.device.index):
+                device = comm_handle.device
+                assert device is not None
+                with torch.accelerator.device_index(device.index):
                     comm_handle.nccl_lib.ncclCommDestroy(comm_handle.nccl_comm)
             except Exception as e:
                 logger.warning("Failed to destroy NCCL comm: %s", e)
-- 
